{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musicReveal",
  "version": "0.1.0",
  "identifier": "io.github.tlyao.musicreveal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "musicReveal",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 21, "y": 21 },
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/covers/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
